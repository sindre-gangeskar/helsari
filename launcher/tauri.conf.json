{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helsari",
  "version": "0.1.0",
  "identifier": "dev.helsari.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Helsari",
        "width": 1120,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
